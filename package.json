{
  "name": "st-card-editor",
  "version": "2.9.0",
  "description": "SillyTavern Character Card Reader & Editor - Edit, translate, and enhance character cards with AI",
  "type": "module",
  "scripts": {
    "start": "bun run server.js",
    "dev": "bun --watch run server.js",
    "build": "bun scripts/build.mjs",
    "release": "bun scripts/release.mjs",
    "i18n:check": "bun scripts/check-i18n.mjs",
    "i18n:add": "bun scripts/i18n-add.mjs",
    "vendor:check": "bun scripts/vendor.mjs --check",
    "check:assets": "bun scripts/check-assets.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:unit": "bun test --parallel tests/unit",
    "test:coverage": "bun scripts/check-coverage.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint && bun run typecheck && bun scripts/i18n-add.mjs --check && bun scripts/check-assets.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  }
}
